# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase cli local link/cache
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# rozetta studio: local-only edited token snapshots
/tokens/*.edited.tokens.json

# rozetta studio: local-only AI provider secrets
/.rozetta/*.local.json

# rozetta studio: local runtime database, WAL files, and caches
/.rozetta/runtime/

# Internal docs & local workspace data — kept local, not published
/.docs/
/.rozetta/

# Cruft & internal playbooks — kept local, not published
/archive/
/.cursor/
/.claude/commands/
