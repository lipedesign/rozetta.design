# Supabase / Postgres
# Use Supabase Dashboard > Connect > Direct connection or Session pooler.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional: direct connection for migrations when DATABASE_URL uses a pooler.
DIRECT_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"

# Alternative to DATABASE_URL: keep the password separate and let Rozetta build the URL.
# If DATABASE_URL is present, it wins. Otherwise Rozetta uses the values below.
SUPABASE_DB_PASSWORD="your-database-password"
SUPABASE_DB_HOST="aws-1-us-west-2.pooler.supabase.com"
SUPABASE_DB_PORT="5432"
SUPABASE_DB_NAME="postgres"
SUPABASE_DB_USER="postgres.[YOUR-PROJECT-REF]"
DATABASE_MAX_CONNECTIONS="1"

# Public Supabase project metadata. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Optional server-side secret used to sign temporary Figma Bridge pairing codes.
# If omitted, Rozetta falls back to AUTH_SECRET/SUPABASE_JWT_SECRET/DATABASE_URL on the server.
FIGMA_BRIDGE_PAIRING_SECRET="replace-with-a-long-random-secret"

# Optional local bypass for tests or offline UI work. Do not use in production.
# ROZETTA_AUTH_MODE="dev"

# Tests only. Do not set this for normal app runtime.
# ROZETTA_DB_DRIVER="pglite"
